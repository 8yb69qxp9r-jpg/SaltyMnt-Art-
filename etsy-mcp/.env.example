# ── Required ──────────────────────────────────────────────────────────────────
# Get from https://www.etsy.com/developers/your-account → Apps → Your App → Keystring
ETSY_API_KEY=your_api_keystring_here

# ── Optional but recommended ──────────────────────────────────────────────────
# Your numeric Etsy shop ID (auto-detected from OAuth if omitted)
ETSY_SHOP_ID=

# OAuth tokens — obtained by running: npm run auth
# The auth script saves these to .tokens.json automatically.
# You can also paste them here if you prefer env vars over the file.
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=

# ── HTTP server settings (only needed for remote/cloud deployment) ─────────────
PORT=3001
# Optional: protect your deployed server with a secret header
MCP_AUTH_TOKEN=

# ── Transport mode ────────────────────────────────────────────────────────────
# "stdio" → use with Claude Desktop or claude CLI  (default)
# "http"  → use with Claude Code on the Web (deploy to Railway / Render / Fly)
TRANSPORT=stdio
